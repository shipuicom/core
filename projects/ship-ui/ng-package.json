{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ship-ui",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "styles"
    ]
  },
  "assets": [
    "styles/**/*",
    "assets/**/*",
    {
      "glob": "**/*",
      "input": "bin",
      "output": "bin",
      "ignore": [
        "**/*.spec.ts",
        "ship-migrate.ts",
        "ship-styles.ts",
        "migrations/**",
        "tsconfig.app.json",
        "src/scanner.zig"
      ]
    },
    "snippets/**/*",
    "ship-code/vendor/vscode-oniguruma/onig.wasm",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "inlineStyleLanguage": "scss",
  "allowedNonPeerDependencies": [
    "harfbuzzjs",
    "wawoff2",
    "@phosphor-icons/web"
  ]
}
